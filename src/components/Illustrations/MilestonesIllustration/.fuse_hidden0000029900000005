@use 'src/styles/mixins' as m;
@use 'src/styles/variables' as v;

// Keyframes — prefixed with mi- to avoid global name collisions
@keyframes mi-fI {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes mi-sU {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes mi-eD {
  from {
    max-height: 0;
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    max-height: 620px;
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes mi-bF {
  from {
    width: 0;
  }

  to {
    width: var(--w);
  }
}

@keyframes mi-cR {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(90deg);
  }
}

// Root block. Pixel-perfect illustration of the Milestones page in
// ReportPortal. Natural max-width: 760 px; auto-scales below via CSS only
// (no JS ResizeObserver — layout is vertical without floating cards, so
// max-width + width:100% is sufficient).
// All HEX colors below are illustration-specific (greens for pass states,
// teals for active states). They don't map to design-system tokens and
// are intentionally kept inline — adding 30+ one-off CSS variables would
// pollute the global namespace without giving anything reusable.

.mi {
  width: 100%;
  max-width: 760px;
  margin: 0 auto;

  // Start hidden — revealed via --visible modifier
  opacity: 0;
  text-align: left;
  line-height: 1.25; // illu-base — illustrations were tuned to this; website base lh differs
  font-family: -apple-system, blinkmacsystemfont, 'Segoe UI', sans-serif;

  // ── Animation utility classes — all paused; resume via --visible modifier
  &__hd {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    border-bottom: 0.5px solid #d8e4ee;
    padding: 12px 18px 14px;
    background: #fff;
    animation: mi-sU 0.4s ease both 0.15s;
    animation-play-state: paused;
  }

  &__ms-row {
    border: 0.5px solid #e8edf5;
    border-radius: 8px;
    box-shadow: 0 1px 4px rgb(0 80 120 / 0.05);
    background: #fff;
    overflow: hidden;
    animation: mi-sU 0.38s ease both;
    animation-play-state: paused;

    &--1 {
      animation-delay: 0.3s;
    }

    &--2 {
      animation-delay: 0.5s;
    }

    &--3 {
      animation-delay: 0.7s;
    }

    &--4 {
      animation-delay: 0.9s;
    }
  }

  &__ms-hdr {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    cursor: default;
  }

  &__xb {
    overflow: hidden;
    animation: mi-eD 0.55s cubic-bezier(0.22, 0.68, 0, 1.1) both 1.2s;
    animation-play-state: paused;
  }

  &__chevron {
    display: inline-block;
    animation: mi-cR 0.3s ease both 1.15s;
    animation-play-state: paused;
  }

  &__pr-row {
    display: flex;
    align-items: center;
    border-top: 0.5px solid #eef3f8;
    padding: 9px 32px;
    animation: mi-sU 0.28s ease both;
    animation-play-state: paused;

    &:nth-child(2) {
      animation-delay: 1.4s;
    }

    &:nth-child(3) {
      animation-delay: 1.52s;
    }

    &:nth-child(4) {
      animation-delay: 1.63s;
    }

    &:nth-child(5) {
      animation-delay: 1.74s;
    }

    &:nth-child(6) {
      animation-delay: 1.85s;
    }
  }

  &__ctp {
    animation: mi-sU 0.28s ease both 1.96s;
    animation-play-state: paused;
  }

  &__bar-fill {
    height: 100%;
    border-radius: 2px;
    background: #009dbb;
    animation: mi-bF 0.6s ease both;
    animation-play-state: paused;

    &--1 {
      --w: 78%;

      animation-delay: 1.5s;
    }

    &--2 {
      --w: 100%;

      background: #00b884;
      animation-delay: 1.62s;
    }

    &--3 {
      --w: 100%;

      background: #00b884;
      animation-delay: 1.73s;
    }

    &--4 {
      --w: 32%;

      animation-delay: 1.84s;
    }

    &--5 {
      --w: 16%;

      animation-delay: 1.95s;
    }
  }

  // ── Resume all animations once in viewport
  &--visible {
    animation: mi-fI 0.5s ease forwards;
    animation-play-state: running;

    .mi__hd,
    .mi__ms-row,
    .mi__xb,
    .mi__chevron,
    .mi__pr-row,
    .mi__ctp,
    .mi__bar-fill {
      animation-play-state: running;
    }
  }

  // Respect reduced-motion preference
  @media (prefers-reduced-motion: reduce) {
    opacity: 1;

    .mi__hd,
    .mi__ms-row,
    .mi__chevron,
    .mi__pr-row,
    .mi__ctp {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    .mi__xb {
      max-height: 620px !important;
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    .mi__bar-fill {
      width: var(--w) !important;
      animation: none !important;
    }
  }

  // Mobile — show everything immediately, no animation
  @media (width <= 767px) {
    opacity: 1;

    &--visible {
      animation: none !important;
    }

    .mi__hd,
    .mi__ms-row,
    .mi__chevron,
    .mi__pr-row,
    .mi__ctp {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    .mi__xb {
      max-height: 620px !important;
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    .mi__bar-fill {
      width: var(--w) !important;
      animation: none !important;
    }
  }

  // ── Static elements (no animation, layout only)
  &__nb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 24px;
    border-radius: 5px;

    &--on {
      background: rgb(0 180 213 / 0.2);
    }
  }

  &__pill {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    width: 90px;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 10.5px;
    font-weight: 600;
    cursor: default;
  }

  &__col-hdr {
    display: flex;
    align-items: center;
    border-top: 0.5px solid #dce9f0;
    padding: 6px 32px;
    background: #f0f6fa;
  }

  &__cl {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #8791ab;
    font-size: 9px;
    font-weight: 600;
  }

  &__bar-track {
    flex-shrink: 0;
    width: 80px;
    height: 4px;
    border-radius: 2px;
    background: #e4eef5;
    overflow: hidden;
  }

  // ── Layout shell (3-row scene wrapper)
  &__shell {
    display: flex;
    height: 488px;
    border: 0.5px solid #c8dde6;
    border-radius: 14px;
    box-shadow: 0 4px 28px rgb(0 80 120 / 0.1);
    overflow: hidden;

    // Scale the 760px-wide scene to fit the mobile container
    @media (width <= 767px) {
      width: 760px;
      zoom: calc((100vw - 32px) / 760px);
    }
  }
}
